import joblib
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import ConfusionMatrixDisplay

"""
bdt_file_only_coll = '/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection_new_PID/provaBDT_newvars_onlycoll/gbdt_model_small_stat_newTS_newvars_onlycoll.pkl'
bdt_file_all_planes = '/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection_new_PID/provaBDT_newTS_newvars_multiplane/gbdt_model_small_stat_newTS_multiplane_newvars.pkl'
bdt_file_newTS = '/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection_new_PID/provaBDT_newTS/gbdt_model_small_stat_newTS.pkl'

gbdt_model = joblib.load(bdt_file_newTS)


data = np.genfromtxt(
    '/exp/icarus/data/users/nsommagg/dump_lkl_ratios_70percent.txt',
    dtype=[('classe',int),
    ('lr1',float),
    ('lr2',float),
    ('lr3',float),
    ('lr4',float),
    ('lr5',float),
    ('lr6',float),
    ('lr7',float),
    ('lr8',float),
    ('lr9',float),
    ('lr10',float),
    ('lr11',float),
    ('lr12',float),
    ('lr13',float),
    ('lr14',float),
    ('lr15',float),
    ('depE',float),
    ('depE_daughter',float),
    ('angle_daughter',float),
    ('plane',int)],
    encoding="utf-8",
    delimiter=" "
)

print('n muon rising coll',len(data[(data['classe']==0) & (data['plane']==2)]))
print('n muon mip coll',len(data[(data['classe']==1) & (data['plane']==2)]))
print('n proton rising coll',len(data[(data['classe']==2) & (data['plane']==2)]))
print('n proton interacting coll',len(data[(data['classe']==3) & (data['plane']==2)]))
print('n pion rising coll',len(data[(data['classe']==4) & (data['plane']==2)]))
print('n pion mip coll',len(data[(data['classe']==5) & (data['plane']==2)]))

classes_labels = ['muon_rising', 'muon mip', 'proton_rising', 'proton_interacting', 'pion_rising', 'pion_interacting']
#feature_names = [f'lr{i}' for i in range(1,16)] + ['depE', 'depE_daughter', 'angle_daughter']
feature_names = [f'lr{i}' for i in range(1,16)] + ['depE']

data_test_coll = data[data['plane']==2]

X_test_coll = np.column_stack([data_test_coll[name] for name in feature_names])
y_test_coll = data_test_coll['classe']

X_test_all_planes = np.column_stack([data[name] for name in feature_names])
y_test_all_planes = data['classe']

#X_test = X_test_coll
#y_test = y_test_coll

X_test = X_test_all_planes
y_test = y_test_all_planes

y_pred = gbdt_model.predict(X_test)

model_title = 'train ONLY COLL'
#model_title = 'train ALL PLANES'
#selection_title = 'test ONLY COLL'
selection_title = 'test ALL PLANES'

#####################
# efficiency matrix #
#####################
disp_confusion_matrix_efficiency = ConfusionMatrixDisplay.from_predictions(y_test, y_pred, display_labels=classes_labels, normalize='true', cmap=plt.cm.Blues)
plt.xticks(rotation=60)
plt.title("EFFICIENCY confusion matrix - 70% stat\n {} - {}".format(model_title,selection_title), fontsize=18)
plt.savefig("newTS_efficiency_confusion_matrix_{}_{}.pdf".format(model_title,selection_title).replace(' ','_'), format='pdf', bbox_inches='tight')
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('predicted label', fontsize=18)
plt.ylabel('true label', fontsize=18)
plt.close()

#################
# purity matrix #
#################
disp_confusion_matrix_purity = ConfusionMatrixDisplay.from_predictions(y_test, y_pred, display_labels=classes_labels, normalize='pred', cmap=plt.cm.Blues)
plt.xticks(rotation=60)
plt.title("PURITY confusion matrix - 70% stat\n {} - {}".format(model_title,selection_title), fontsize=18)
plt.savefig("newTS_purity_confusion_matrix_{}_{}.pdf".format(model_title,selection_title).replace(' ','_'), format='pdf', bbox_inches='tight')
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('predicted label', fontsize=18)
plt.ylabel('true label', fontsize=18)
plt.close()

##############
# row matrix #
##############
disp_confusion_matrix_row = ConfusionMatrixDisplay.from_predictions(y_test, y_pred, display_labels=classes_labels, normalize=None, cmap=plt.cm.Blues, values_format='d')
plt.xticks(rotation=60)
plt.title("confusion matrix - 70% stat\n {} - {}".format(model_title,selection_title), fontsize=18)
plt.savefig("newTS_row_confusion_matrix_{}_{}.pdf".format(model_title,selection_title).replace(' ','_'), format='pdf', bbox_inches='tight')
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('predicted label', fontsize=18)
plt.ylabel('true label', fontsize=18)
plt.close()

