depE_data = np.genfromtxt(
    '/exp/icarus/data/users/nsommagg/dump_lkl_ratios_70percent.txt',
    dtype=[('class',int),
    ('lr1',float),
    ('lr2',float),
    ('lr3',float),
    ('lr4',float),
    ('lr5',float),
    ('lr6',float),
    ('lr7',float),
    ('lr8',float),
    ('lr9',float),
    ('lr10',float),
    ('lr11',float),
    ('lr12',float),
    ('lr13',float),
    ('lr14',float),
    ('lr15',float),
    ('depE',float),
    ('depE_daughter',float),
    ('angle_daughter',float),
    ('plane',int)],
    encoding="utf-8",
    delimiter=" "
)

class0 = depE_data[depE_data['class']==0]
class1 = depE_data[depE_data['class']==1]
class2 = depE_data[depE_data['class']==2]
class3 = depE_data[depE_data['class']==3]
class4 = depE_data[depE_data['class']==4]
class5 = depE_data[depE_data['class']==5]

plt.hist(class0['depE'], range=(0,100), bins=50, histtype='step', color='cornflowerblue', label='muon rising', linewidth=2, density=True)
plt.hist(class0['depE'], range=(0,100), bins=50, histtype='stepfilled', color='cornflowerblue', alpha=0.8, density=True)

plt.hist(class1['depE'], range=(0,100), bins=50, histtype='step', color='deepskyblue', label='muon mip', linewidth=2, density=True)
plt.hist(class1['depE'], range=(0,100), bins=50, histtype='stepfilled', color='deepskyblue', alpha=0.8, density=True)

plt.hist(class2['depE'], range=(0,100), bins=50, histtype='step', color='darkgreen', label='proton rising', linewidth=2, density=True)
plt.hist(class2['depE'], range=(0,100), bins=50, histtype='stepfilled', color='darkgreen', alpha=0.8, density=True)

plt.hist(class3['depE'], range=(0,100), bins=50, histtype='step', color='black', label='proton interacting', linewidth=2, density=True)
plt.hist(class3['depE'], range=(0,100), bins=50, histtype='stepfilled', color='black', alpha=0.8, density=True)

plt.hist(class4['depE'], range=(0,100), bins=50, histtype='step', color='orange', label='pion rising', linewidth=2, density=True)
plt.hist(class4['depE'], range=(0,100), bins=50, histtype='stepfilled', color='orange', alpha=0.8, density=True)

plt.hist(class5['depE'], range=(0,100), bins=50, histtype='step', color='red', label='pion interacting', linewidth=2, density=True)
plt.hist(class5['depE'], range=(0,100), bins=50, histtype='stepfilled', color='red', alpha=0.8, density=True)

plt.xlabel('Desposited Energy [MeV]', fontsize=18)
plt.ylabel('counts (area normalized)', fontsize=18)
plt.title("deposited Energy (last 5 cm)", fontsize=18)
leg = plt.legend(loc='upper right', fontsize=14)
leg.get_frame().set_facecolor('white')  # sfondo bianco della legenda
leg.get_frame().set_alpha(1.0)          # opaco
plt.setp(leg.get_title(), fontweight='bold')
plt.setp(plt.gca().get_legend().get_title(), fontweight='bold')
plt.xticks(np.arange(0,100,10), fontsize=14, rotation=60)
plt.yticks(fontsize=14)
#plt.yscale('log')
plt.savefig('depE_IFAE.pdf', format='pdf', bbox_inches='tight')
plt.close()

