#labels = ['no conditions','primary', 'trackscore > 0.5', 'vertex-start dist. < 10 cm', 'contained', 'hit compl. and pur. > 0.5']

all_tracks = [all_tracks_nocuts,all_tracks_hit_c_and_p]
colors = ['red','orange']
labels = ['no conditions', 'hit compl. and pur. > 0.5']


for i,dataset in enumerate(all_tracks):
    #ratio,errors = efficiency(dataset,'pi',100) #<--
    ratio,errors = purity(dataset,'pi',100) #<--

    bin_edges = np.arange(0,101,1)
    bin_centers = 0.5 * (bin_edges[:-1] + bin_edges[1:])

    plt.stairs(ratio, bin_edges, color=colors[i], linewidth=1,label=labels[i])
    plt.errorbar(bin_centers, ratio, yerr=errors, fmt='o',markersize=2, color=colors[i], alpha=0.8, elinewidth=1) 

plt.title("pion selection purity", fontsize=18) #<--
plt.xticks(np.arange(0,100,5), fontsize=14, rotation=60)
