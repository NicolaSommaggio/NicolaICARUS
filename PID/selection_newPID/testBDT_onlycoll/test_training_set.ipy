import numpy as np
import matplotlib.pyplot as plt

data = np.genfromtxt(
    '/exp/icarus/data/users/nsommagg/dump_lkl_ratios_gbdt_withdepE_smallMC_newTS_newvars_only_coll.txt',
    dtype=[('classe',int),
    ('lr1',float),
    ('lr2',float),
    ('lr3',float),
    ('lr4',float),
    ('lr5',float),
    ('lr6',float),
    ('lr7',float),
    ('lr8',float),
    ('lr9',float),
    ('lr10',float),
    ('lr11',float),
    ('lr12',float),
    ('lr13',float),
    ('lr14',float),
    ('lr15',float),
    ('depE',float),
    ('depE_daughter',float),
    ('angle_daughter',float)],
    encoding="utf-8",
    delimiter=" "
)

class0 = data[data['classe']==0]
class1 = data[data['classe']==1]
class2 = data[data['classe']==2]
class3 = data[data['classe']==3]
class4 = data[data['classe']==4]
class5 = data[data['classe']==5]

plt.hist(class0['lr10'],bins=50,range=(-1,1),histtype='step',label=r'$\mu$ rising', lw=2, color='blue', density=True)
plt.hist(class0['lr10'],bins=50,range=(-1,1),histtype='stepfilled', alpha=0.7, color='blue', density=True)

plt.hist(class1['lr10'],bins=50,range=(-1,1),histtype='step',label=r'$\mu$ mip', lw=2, color='deepskyblue',density=True)
plt.hist(class1['lr10'],bins=50,range=(-1,1),histtype='stepfilled', alpha=0.7, color='deepskyblue',density=True)

plt.hist(class2['lr10'],bins=50,range=(-1,1),histtype='step',label=r'$p$ rising', lw=2, color='darkgreen',density=True)
plt.hist(class2['lr10'],bins=50,range=(-1,1),histtype='stepfilled', alpha=0.7, color='darkgreen',density=True)

plt.hist(class3['lr10'],bins=50,range=(-1,1),histtype='step',label=r'$p$ interacting', lw=2, color='limegreen',density=True)
plt.hist(class3['lr10'],bins=50,range=(-1,1),histtype='stepfilled', alpha=0.7, color='limegreen',density=True)

plt.hist(class4['lr10'],bins=50,range=(-1,1),histtype='step',label=r'$\pi$ rising', lw=2, color='red',density=True)
plt.hist(class4['lr10'],bins=50,range=(-1,1),histtype='stepfilled', alpha=0.7, color='red',density=True)

plt.hist(class5['lr10'],bins=50,range=(-1,1),histtype='step',label=r'$\pi$ interacting', lw=2, color='orange',density=True)
plt.hist(class5['lr10'],bins=50,range=(-1,1),histtype='stepfilled', alpha=0.7, color='orange',density=True)


plt.title("p RISING / p INTTERACTING - training set", fontsize=18)
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('Likelihood ratio', fontsize=18)
plt.ylabel('counts (area normalized)', fontsize=18)
plt.legend(loc = 'best', fontsize=14)
plt.savefig("pro_ris_pro_int_training_set_only_coll.pdf", format='pdf', bbox_inches='tight')
plt.close()



plt.hist(class0['depE'],bins=50,range=(0,100),histtype='step',label=r'$\mu$ rising', lw=2, color='blue', density=True)
plt.hist(class0['depE'],bins=50,range=(0,100),histtype='stepfilled', alpha=0.7, color='blue', density=True)

plt.hist(class1['depE'],bins=50,range=(0,100),histtype='step',label=r'$\mu$ mip', lw=2, color='deepskyblue',density=True)
plt.hist(class1['depE'],bins=50,range=(0,100),histtype='stepfilled', alpha=0.7, color='deepskyblue',density=True)

plt.hist(class2['depE'],bins=50,range=(0,100),histtype='step',label=r'$p$ rising', lw=2, color='darkgreen',density=True)
plt.hist(class2['depE'],bins=50,range=(0,100),histtype='stepfilled', alpha=0.7, color='darkgreen',density=True)

plt.hist(class3['depE'],bins=50,range=(0,100),histtype='step',label=r'$p$ interacting', lw=2, color='limegreen',density=True)
plt.hist(class3['depE'],bins=50,range=(0,100),histtype='stepfilled', alpha=0.7, color='limegreen',density=True)

plt.hist(class4['depE'],bins=50,range=(0,100),histtype='step',label=r'$\pi$ rising', lw=2, color='red',density=True)
plt.hist(class4['depE'],bins=50,range=(0,100),histtype='stepfilled', alpha=0.7, color='red',density=True)

plt.hist(class5['depE'],bins=50,range=(0,100),histtype='step',label=r'$\pi$ interacting', lw=2, color='orange',density=True)
plt.hist(class5['depE'],bins=50,range=(0,100),histtype='stepfilled', alpha=0.7, color='orange',density=True)


plt.title("deposited Energy training set [MeV]", fontsize=18)
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('deposited Energy [MeV]', fontsize=18)
plt.ylabel('counts (area normalized)', fontsize=18)
plt.legend(loc = 'best', fontsize=14)
plt.savefig("dep_e_training_set_only_coll.pdf", format='pdf', bbox_inches='tight')
plt.close()

