pred_proba_mu_rising = gbdt_model.predict_proba(X_test[data['classe']==0])
pred_proba_mu_mip = gbdt_model.predict_proba(X_test[data['classe']==1])
pred_proba_pro_rising = gbdt_model.predict_proba(X_test[data['classe']==2])
pred_proba_pro_interacting = gbdt_model.predict_proba(X_test[data['classe']==3])
pred_proba_pi_rising = gbdt_model.predict_proba(X_test[data['classe']==4])
pred_proba_pi_interacting = gbdt_model.predict_proba(X_test[data['classe']==5])

pred_proba_mu = gbdt_model.predict_proba(X_test[(data['classe']==0) | (data['classe']==1)])
pred_proba_pro = gbdt_model.predict_proba(X_test[(data['classe']==2) | (data['classe']==3)])
pred_proba_pi = gbdt_model.predict_proba(X_test[(data['classe']==4) | (data['classe']==5)])


pred_proba = pred_proba_pi_interacting #<--

plt.hist(pred_proba[:,0],bins=100,range=(0,1),histtype='step',label=r'P($\mu$ rising)', lw=2, color='blue')
plt.hist(pred_proba[:,0],bins=100,range=(0,1),histtype='stepfilled', alpha=0.7, color='blue')

plt.hist(pred_proba[:,1],bins=100,range=(0,1),histtype='step',label=r'P($\mu$ mip)', lw=2, color='deepskyblue')
plt.hist(pred_proba[:,1],bins=100,range=(0,1),histtype='stepfilled', alpha=0.7, color='deepskyblue')

