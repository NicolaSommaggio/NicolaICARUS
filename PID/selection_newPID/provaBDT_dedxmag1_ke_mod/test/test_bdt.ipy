import joblib
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import ConfusionMatrixDisplay, confusion_matrix


bdt = "/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection_newPID/provaBDT_dedxmag1_ke/gbdt_model_dedxmag1.pkl"

gbdt_model = joblib.load(bdt)


data = np.genfromtxt(
    '/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection_newPID/provaBDT_dedxmag1_ke/likelihoods_with_ke_test_70percent.txt',
    dtype=[('classe',int),
    ('lr1',float),
    ('lr2',float),
    ('lr3',float),
    ('lr4',float),
    ('lr5',float),
    ('lr6',float),
    ('lr7',float),
    ('lr8',float),
    ('lr9',float),
    ('lr10',float),
    ('lr11',float),
    ('lr12',float),
    ('lr13',float),
    ('lr14',float),
    ('lr15',float),
    ('depE',float),
    ('depE_daughter',float),
    ('angle_daughter',float),
    ('plane',int),
    ('ke_mu_hyp',float),
    ('ke_pi_hyp',float),
    ('ke_pro_hyp',float)],
    encoding="utf-8",
    delimiter=" "
)

print('n muon rising',len(data[data['classe']==0]))
print('n muon mip',len(data[data['classe']==1]))
print('n proton rising',len(data[data['classe']==2]))
print('n proton interacting',len(data[data['classe']==3]))
print('n pion rising',len(data[data['classe']==4]))
print('n pion mip',len(data[data['classe']==5]))

classes_labels = ['muon_rising', 'muon mip', 'proton_rising', 'proton_interacting', 'pion_rising', 'pion_interacting']
feature_names = [f'lr{i}' for i in range(1,16)] + ['depE', 'depE_daughter', 'angle_daughter', 'ke_mu_hyp', 'ke_pi_hyp', 'ke_pro_hyp']

data_test_coll = data[data['plane']==2]

X_test_coll = np.column_stack([data_test_coll[name] for name in feature_names])
y_test_coll = data_test_coll['classe']

X_test_all_planes = np.column_stack([data[name] for name in feature_names])
y_test_all_planes = data['classe']

#X_test = X_test_coll
#y_test = y_test_coll

X_test = X_test_all_planes
y_test = y_test_all_planes

y_pred = gbdt_model.predict(X_test)

model_title = 'train ONLY COLL'
#model_title = 'train ALL PLANES'
#selection_title = 'test ONLY COLL'
selection_title = 'test ALL PLANES'

#####################
# efficiency matrix #
#####################
disp_confusion_matrix_efficiency = ConfusionMatrixDisplay.from_predictions(y_test, y_pred, display_labels=classes_labels, normalize='true', cmap=plt.cm.Blues)
plt.xticks(rotation=60)
plt.title("EFFICIENCY confusion matrix - 70% stat\n {} - {}".format(model_title,selection_title), fontsize=18)
plt.savefig("dedxmag1_ke_efficiency_confusion_matrix_{}_{}.pdf".format(model_title,selection_title).replace(' ','_'), format='pdf', bbox_inches='tight')
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('predicted label', fontsize=18)
plt.ylabel('true label', fontsize=18)
plt.close()

#################
# purity matrix #
#################
disp_confusion_matrix_purity = ConfusionMatrixDisplay.from_predictions(y_test, y_pred, display_labels=classes_labels, normalize='pred', cmap=plt.cm.Blues)
plt.xticks(rotation=60)
plt.title("PURITY confusion matrix - 70% stat\n {} - {}".format(model_title,selection_title), fontsize=18)
plt.savefig("dedxmag1_ke_purity_confusion_matrix_{}_{}.pdf".format(model_title,selection_title).replace(' ','_'), format='pdf', bbox_inches='tight')
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('predicted label', fontsize=18)
plt.ylabel('true label', fontsize=18)
plt.close()

##############
# row matrix #
##############
disp_confusion_matrix_row = ConfusionMatrixDisplay.from_predictions(y_test, y_pred, display_labels=classes_labels, normalize=None, cmap=plt.cm.Blues, values_format='d')
plt.xticks(rotation=60)
plt.title("confusion matrix - 70% stat\n {} - {}".format(model_title,selection_title), fontsize=18)
plt.savefig("dedxmag1_ke_confusion_matrix_{}_{}.pdf".format(model_title,selection_title).replace(' ','_'), format='pdf', bbox_inches='tight')
plt.xticks(fontsize=14)
plt.yticks(fontsize=14)
plt.xlabel('predicted label', fontsize=18)
plt.ylabel('true label', fontsize=18)
plt.close()


cm = confusion_matrix(y_test, y_pred)


matrix3x3 = np.array([
        [cm[0,0] + cm[0,1] + cm[1,0] + cm[1,1] , cm[0,2] + cm[0,3] + cm[1,2] + cm[1,3] , cm[0,4] + cm[0,5] + cm[1,4] + cm[1,5]],
        [cm[2,0] + cm[2,1] + cm[3,0] + cm[3,1] , cm[2,2] + cm[2,3] + cm[3,2] + cm[3,3] , cm[2,4] + cm[2,5] + cm[3,4] + cm[3,5]],
        [cm[4,0] + cm[4,1] + cm[5,0] + cm[5,1] , cm[4,2] + cm[4,3] + cm[5,2] + cm[5,3] , cm[4,4] + cm[4,5] + cm[5,4] + cm[5,5]]
    ])

print(matrix3x3)

mu_eff = matrix3x3[0,0]/(matrix3x3[0,0] + matrix3x3[0,1] + matrix3x3[0,2])
mu_pur = matrix3x3[0,0]/(matrix3x3[0,0] + matrix3x3[1,0] + matrix3x3[2,0])

pro_eff = matrix3x3[1,1]/(matrix3x3[1,0] + matrix3x3[1,1] + matrix3x3[1,2])
pro_pur = matrix3x3[1,1]/(matrix3x3[0,1] + matrix3x3[1,1] + matrix3x3[2,1])

pi_eff = matrix3x3[2,2]/(matrix3x3[2,0] + matrix3x3[2,1] + matrix3x3[2,2])
pi_pur = matrix3x3[2,2]/(matrix3x3[0,2] + matrix3x3[1,2] + matrix3x3[2,2])


print('mu_eff: ', mu_eff, 'mu_pur: ', mu_pur)
print('pro_eff: ', pro_eff, 'pro_pur: ', pro_pur)
print('pi_eff: ', pi_eff, 'pi_pur: ', pi_pur)

