plt.hist(pred_proba[:,3],bins=100,range=(0,1),histtype='step',label=r'P(p int.)', lw=2, color='limegreen')
plt.hist(pred_proba[:,3],bins=100,range=(0,1),histtype='stepfilled', alpha=0.7, color='limegreen')

plt.hist(pred_proba[:,4],bins=100,range=(0,1),histtype='step',label=r'P($\pi$ rising)', lw=2, color='red')
