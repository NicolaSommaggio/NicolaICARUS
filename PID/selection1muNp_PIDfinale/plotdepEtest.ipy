import numpy as np
import matplotlib.pyplot as plt


respun = np.genfromtxt(
    '/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection1muNp_PIDfinale/depEdump_respun.txt',
    dtype = [
        ('depE_5',float),
        ('depE_10',float),
        ('depE_25',float),
        ('true1muNp',int)
    ],
    encoding = 'utf-8',
    delimiter = None
)

highLT = np.genfromtxt(
    '/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection1muNp_PIDfinale/depEdump_highLT.txt',
    dtype = [
        ('depE_5',float),
        ('depE_10',float),
        ('depE_25',float),
        ('true1muNp',int)
    ],
    encoding = 'utf-8',
    delimiter = None
)

null = np.genfromtxt(
    '/exp/icarus/app/users/nsommagg/NicolaICARUS/PID/selection1muNp_PIDfinale/depEdump_null.txt',
    dtype = [
        ('depE_5',float),
        ('depE_10',float),
        ('depE_25',float),
        ('true1muNp',int)
    ],
    encoding = 'utf-8',
    delimiter = None
)

